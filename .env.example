# --- CRM ---
CRM_URL=https://crm.exemplo.com.br/
CRM_PEDIDOS_URL=https://crm.exemplo.com.br/pedidos
CRM_EMAIL=usuario@exemplo.com.br
CRM_SENHA=troque-esta-senha

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=minha-instancia
EVOLUTION_API_KEY=sua-chave-da-evolution-api

# --- Destinatários ---
# Número da diretoria (recebe o resumo final) - obrigatório
WHATSAPP_DIRETORIA=5511900000000
# ID (JID) do grupo da equipe - opcional; deixe vazio para não enviar ao grupo
WHATSAPP_GRUPO=
# Supervisor que recebe alerta quando um consultor não tem número cadastrado - opcional
WHATSAPP_SUPERVISOR=5511900000009

# --- Equipe ---
# Caminho do JSON {"NOME DO CONSULTOR": "numero"} (padrão: equipe.json)
EQUIPE_ARQUIVO=equipe.json
